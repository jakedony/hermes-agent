{
  "listenAddr": "127.0.0.1:8765",
  "tokenFile": "state/token",
  "allowedOrigins": [],
  "logLevel": "info",

  "maxMessageBytes": 65536,
  "maxQuestionBytes": 32768,
  "maxConnections": 8,
  "maxSessions": 4,
  "maxConcurrentRequests": 2,
  "maxTurnsPerSession": 50,
  "maxHistoryBytes": 524288,
  "maxWorkerRecordBytes": 4194304,

  "requestTimeout": "180s",
  "cancelGrace": "10s",
  "idleSessionTimeout": "15m",
  "workerStartTimeout": "90s",
  "workerStopGrace": "5s",
  "shutdownTimeout": "20s",

  "preflight": true,
  "forwardWorkerStderr": false,

  "worker": {
    "command": [
      "/workspace/scripts/run-in-hermes-env",
      "python3",
      "/workspace/apps/hermes-bridge/worker/hermes_worker.py"
    ],
    "workdir": "state/workdir",
    "hermesHome": "",
    "maxIterations": 4,
    "memory": false
  }
}
